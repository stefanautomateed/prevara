# Schedule configuration (times in 24-hour format HH:MM)
SCHEDULE_TIMES=10:00,14:00,18:00

# Target websites (comma-separated)
TARGET_URLS=https://noro.rs/,https://limitlesss.rs/

# Browser settings (headless=true to run without visible browser)
HEADLESS=false

# Delays (in seconds) - to make automation look more natural
MIN_DELAY=1
MAX_DELAY=3

# Web interface settings
PORT=5000
AUTO_START_SCHEDULER=true
SECRET_KEY=change-this-to-a-random-secret-key
