# Schedule configuration (times in 24-hour format HH:MM)
SCHEDULE_TIMES=10:00,14:00,18:00

# Target website
TARGET_URL=https://noro.rs/

# Browser settings (headless=true to run without visible browser)
HEADLESS=false

# Delays (in seconds) - to make automation look more natural
MIN_DELAY=1
MAX_DELAY=3
